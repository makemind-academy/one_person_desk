{
  "type": "page",
  "metadata": {
    "title": "Today"
  },
  "onInit": {
    "type": "tool",
    "tool": "desk.all",
    "params": {}
  },
  "state": {
    "initial": {
      "rows": [],
      "rowCount": 0,
      "late": 0,
      "hats": "",
      "hatCount": 0,
      "atStake": "",
      "rule": "",
      "headline": ""
    }
  },
  "content": {
    "type": "container",
    "decoration": {
      "color": "{{theme.color.surfaceContainerHighest}}"
    },
    "child": {
      "type": "linear",
      "direction": "vertical",
      "children": [
        {
          "type": "container",
          "padding": {
            "left": 22,
            "right": 22,
            "top": 20,
            "bottom": 16
          },
          "decoration": {
            "color": "{{theme.color.surface}}",
            "border": {
              "bottom": true,
              "color": "{{theme.color.outline}}",
              "width": 1
            }
          },
          "child": {
            "type": "linear",
            "direction": "horizontal",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "linear",
                "direction": "vertical",
                "children": [
                  {
                    "type": "text",
                    "content": "{{hats}}",
                    "style": {
                      "fontSize": 12,
                      "color": "{{theme.color.onSurfaceVariant}}",
                      "letterSpacing": 1.6
                    }
                  },
                  {
                    "type": "text",
                    "content": "{{headline}}",
                    "style": {
                      "fontSize": 21,
                      "color": "{{theme.color.onSurface}}",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "gap": 4
              },
              {
                "type": "spacer"
              },
              {
                "type": "linear",
                "direction": "vertical",
                "children": [
                  {
                    "type": "text",
                    "content": "AT STAKE",
                    "style": {
                      "fontSize": 11,
                      "color": "{{theme.color.onSurfaceVariant}}",
                      "letterSpacing": 1.6
                    }
                  },
                  {
                    "type": "text",
                    "content": "{{atStake}}",
                    "style": {
                      "fontSize": 26,
                      "color": "{{theme.color.onSurface}}",
                      "fontFamily": "JetBrainsMono"
                    }
                  }
                ],
                "gap": 4,
                "crossAxisAlignment": "end"
              }
            ]
          }
        },
        {
          "type": "container",
          "padding": {
            "left": 24,
            "right": 24,
            "top": 10,
            "bottom": 4
          },
          "child": {
            "type": "linear",
            "direction": "horizontal",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "button",
                "label": "All hats",
                "variant": "outlined",
                "onTap": {
                  "type": "tool",
                  "tool": "desk.all",
                  "params": {}
                }
              },
              {
                "type": "box",
                "width": 10
              },
              {
                "type": "button",
                "label": "books",
                "variant": "outlined",
                "onTap": {
                  "type": "tool",
                  "tool": "desk.hat",
                  "params": {
                    "hat": "books"
                  }
                }
              },
              {
                "type": "box",
                "width": 10
              },
              {
                "type": "button",
                "label": "making",
                "variant": "outlined",
                "onTap": {
                  "type": "tool",
                  "tool": "desk.hat",
                  "params": {
                    "hat": "making"
                  }
                }
              },
              {
                "type": "box",
                "width": 10
              },
              {
                "type": "button",
                "label": "sales",
                "variant": "outlined",
                "onTap": {
                  "type": "tool",
                  "tool": "desk.hat",
                  "params": {
                    "hat": "sales"
                  }
                }
              },
              {
                "type": "box",
                "width": 10
              },
              {
                "type": "button",
                "label": "supply",
                "variant": "outlined",
                "onTap": {
                  "type": "tool",
                  "tool": "desk.hat",
                  "params": {
                    "hat": "supply"
                  }
                }
              }
            ]
          }
        },
        {
          "type": "expanded",
          "child": {
            "type": "container",
            "padding": {
              "left": 22,
              "right": 22,
              "top": 16,
              "bottom": 8
            },
            "child": {
              "type": "container",
              "padding": {
                "all": 18
              },
              "decoration": {
                "color": "{{theme.color.surface}}",
                "borderRadius": 14,
                "border": {
                  "color": "{{theme.color.outline}}",
                  "width": 1
                }
              },
              "child": {
                "type": "list",
                "items": "{{rows}}",
                "shrinkWrap": true,
                "itemSpacing": 10,
                "emptyMessage": "Nothing on the desk today",
                "itemTemplate": {
                  "type": "linear",
                  "direction": "vertical",
                  "gap": 4,
                  "children": [
                    {
                      "type": "linear",
                      "direction": "horizontal",
                      "crossAxisAlignment": "center",
                      "children": [
                        {
                          "type": "container",
                          "width": 84,
                          "child": {
                            "type": "text",
                            "content": "{{item.due}}",
                            "textAlign": "start",
                            "maxLines": 1,
                            "style": {
                              "fontSize": 14,
                              "color": "{{theme.color.primary}}",
                              "textAlign": "start",
                              "fontFamily": "JetBrainsMono"
                            }
                          },
                          "alignment": "centerStart"
                        },
                        {
                          "type": "box",
                          "width": 0
                        },
                        {
                          "type": "expanded",
                          "child": {
                            "type": "text",
                            "content": "{{item.what}}",
                            "style": {
                              "fontSize": 16,
                              "color": "{{theme.color.onSurface}}"
                            }
                          }
                        },
                        {
                          "type": "box",
                          "width": 0
                        },
                        {
                          "type": "container",
                          "width": 90,
                          "child": {
                            "type": "text",
                            "content": "{{item.money}}",
                            "textAlign": "end",
                            "style": {
                              "fontSize": 14,
                              "color": "{{theme.color.onSurface}}",
                              "textAlign": "end",
                              "fontFamily": "JetBrainsMono"
                            },
                            "maxLines": 1
                          },
                          "alignment": "centerEnd"
                        },
                        {
                          "type": "box",
                          "width": 0
                        },
                        {
                          "type": "container",
                          "width": 80,
                          "child": {
                            "type": "text",
                            "content": "{{item.hat}}",
                            "textAlign": "end",
                            "style": {
                              "fontSize": 13,
                              "color": "{{theme.color.onSurfaceVariant}}",
                              "textAlign": "end",
                              "fontFamily": "JetBrainsMono"
                            },
                            "maxLines": 1
                          },
                          "alignment": "centerEnd"
                        }
                      ]
                    },
                    {
                      "type": "container",
                      "padding": {
                        "left": 84
                      },
                      "child": {
                        "type": "text",
                        "content": "{{item.source}}",
                        "style": {
                          "fontSize": 12,
                          "color": "{{theme.color.onSurfaceVariant}}"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "container",
          "padding": {
            "left": 22,
            "right": 22,
            "top": 0,
            "bottom": 8
          },
          "child": {
            "type": "container",
            "padding": {
              "all": 18
            },
            "decoration": {
              "color": "{{theme.color.surface}}",
              "borderRadius": 14,
              "border": {
                "color": "{{theme.color.outline}}",
                "width": 1
              }
            },
            "child": {
              "type": "linear",
              "direction": "vertical",
              "children": [
                {
                  "type": "linear",
                  "direction": "horizontal",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "text",
                      "content": "WHY THIS ORDER",
                      "style": {
                        "fontSize": 11,
                        "color": "{{theme.color.onSurfaceVariant}}",
                        "letterSpacing": 1.6
                      }
                    },
                    {
                      "type": "spacer"
                    },
                    {
                      "type": "text",
                      "content": "{{late}} late",
                      "style": {
                        "fontSize": 14,
                        "color": "{{theme.color.warning}}",
                        "fontFamily": "JetBrainsMono"
                      }
                    }
                  ]
                },
                {
                  "type": "linear",
                  "direction": "horizontal",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "text",
                      "content": "{{rule}}",
                      "style": {
                        "fontSize": 13,
                        "color": "{{theme.color.onSurface}}"
                      }
                    }
                  ]
                }
              ],
              "gap": 8
            }
          }
        },
        {
          "type": "container",
          "padding": {
            "left": 22,
            "right": 22,
            "top": 4,
            "bottom": 18
          },
          "child": {
            "type": "linear",
            "direction": "horizontal",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "text",
                "content": "{{rowCount}} items across {{hatCount}} hats",
                "style": {
                  "fontSize": 13,
                  "color": "{{theme.color.onSurfaceVariant}}"
                }
              }
            ]
          }
        }
      ],
      "crossAxisAlignment": "stretch"
    }
  }
}
